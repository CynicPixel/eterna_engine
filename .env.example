NODE_ENV=development
PORT=3000

# DEX Mode: 'mock' for testing, 'devnet' for real Solana devnet execution
DEX_MODE=mock

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_PRIVATE_KEY=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/eterna_engine

# Redis
REDIS_URL=redis://localhost:6379

BULLMQ_CONCURRENCY=10
JOB_TIMEOUT_MS=30000
MAX_RETRY_ATTEMPTS=3
